---
import Layout from '@layouts/Layout.astro';
import { supabase } from '@/lib/supabase';

const { data: messages, error } = await supabase
  .from('messages')
  .select('id, title, subtitle');

if (error) console.error(error);
---
<Layout>
  <ul>
    {messages?.map(m => (
      <li>
        <b>{m.title}</b>
        <p>{m.subtitle}</p>
      </li>
    ))}
  </ul>
</Layout>
