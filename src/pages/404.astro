---
import Layout from '@layouts/Layout.astro';
---

<Layout>
  <div class="min-h-[70vh] flex flex-col items-center justify-center text-center gap-6">
    <h1 class="text-7xl font-extrabold tracking-tight text-emerald-400">
      404
    </h1>

    <p class="text-xl text-neutral-300">
      Oops… this page drifted into the void 🕳️
    </p>

    <a
      href="/"
      class="inline-flex items-center gap-2 rounded-xl bg-emerald-500 px-6 py-3 text-lg font-semibold text-black transition hover:bg-emerald-400 hover:scale-105"
    >
      🏠 Go home
    </a>
  </div>
</Layout>
